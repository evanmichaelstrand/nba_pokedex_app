# Copy to .env.local to override the defaults in .env.

# Which EntrySource implementation to use. Only "csv" exists for now; "api" is planned.
VITE_DATA_SOURCE=csv

# Path of the CSV in public/, relative to the site base URL (no leading slash). Change when a new season's file is dropped in.
VITE_CSV_URL=data/nba_pokemon_matches_unique_2526_clean.csv
